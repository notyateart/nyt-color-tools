    "present": "^1.0.0",
    "rebuild": "^0.1.2",
    "scripts": "^0.1.0",
    "vue": "^3.5.13",
    "vue-draggable-plus": "^0.6.1",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.1",
    "@vitejs/plugin-vue": "^5.2.2",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/tsconfig": "^0.7.0",
    "autoprefixer": "^10.4.21",
    "ava": "^8.0.1",
    "postcss": "^8.5.3",
    "postcss-cli": "^11.0.1",
    "prettier": "3.9.5",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4.1.4",
